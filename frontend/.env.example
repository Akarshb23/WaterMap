# WaterMap frontend configuration.
# Copy this file to `.env` for local development. Never commit secrets.
# Only VITE_ variables are exposed to the browser bundle.

# mock = use local illustrative data; api = call the backend endpoints below
VITE_DATA_MODE=api

# Backend API base URL (this backend exposes routes under /api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=15000

# Public display name of the app
VITE_APP_NAME=WaterMap

# Map tile provider template (no API key required for public OSM tiles)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
