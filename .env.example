# WaterMap frontend environment variables.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Only `VITE_`-prefixed variables are exposed to the browser bundle.

# Base URL of the WaterMap backend API
VITE_API_BASE_URL=http://localhost:8000/api

# Public display name of the app
VITE_APP_NAME=WaterMap

# Map tile provider template (no API key required for the public OSM tiles)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
