# WaterMap Environment Configuration
PROJECT_NAME=WaterMap
PROJECT_VERSION=0.1.0
DEBUG=true

# Database Configuration
# Local SQLite default (zero-configuration dev & testing):
DATABASE_URL=sqlite:///./watermap.db

# Production PostgreSQL / PostGIS:
# DATABASE_URL=postgresql+psycopg2://water_map:password@localhost:5432/water_map
DATABASE_ECHO=false

# Security
SECRET_KEY=change-me-in-production-watermap-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
