# Copy to .env and set values for your environment.
PROJECT_NAME=WaterMap
PROJECT_VERSION=0.2.0
DEBUG=false
DATABASE_URL=sqlite:///./watermap.db
DATABASE_ECHO=false
# For PostgreSQL/PostGIS use: postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
